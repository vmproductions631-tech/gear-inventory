# Supabase project credentials.
# Dashboard -> Project Settings -> API

# Your project's REST URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. This is safe to expose to the browser: it is
# scoped by Row Level Security, which this app relies on for access control.
# Never put the service_role key here — it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
